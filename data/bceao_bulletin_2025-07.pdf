.zn_Content .webform-submission-form .form-item span.file {
    font-size: 16px;
    font-weight: bold;
}
.page-node-7738 .ajax-progress.ajax-progress-throbber,
.page-node-8024 .ajax-progress.ajax-progress-throbber {
    position: relative;
    width: 100%;
    max-width: 580px;
    background-color: transparent;
